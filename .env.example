# Database
DATABASE_URL="postgresql://roamready:password@localhost:5432/roamready"
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="your-jwt-secret-here"
JWT_REFRESH_SECRET="your-refresh-secret-here"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"

# Apple OAuth
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_MONTHLY_PRICE_ID=""
STRIPE_PRO_ANNUAL_PRICE_ID=""

# Anthropic
ANTHROPIC_API_KEY=""

# Google Maps
GOOGLE_MAPS_API_KEY=""

# HERE Routing (truck/RV-aware drive-time engine)
# FEAT-HERE-ROUTING. When USE_HERE_ROUTING=true, the server measures drive
# times with HERE truck routing (rig height/length/weight aware) instead of
# Google's car route — so the approved plan is built on the real RV-safe path.
# Default OFF: any value other than the literal "true" keeps the Google path
# byte-identical. Google is still used for geocoding + display either way.
HERE_API_KEY=""
USE_HERE_ROUTING="false"
# Client mirror (Vite) — when "true", the map line + directions links route
# through HERE's corridor waypoints (display only). Set together with the server
# USE_HERE_ROUTING flag. Off → Google-only display, byte-identical.
VITE_USE_HERE_ROUTING="false"

# Google Large Vehicle Routing (FEAT-LVR-ROUTING). LVR access was provisioned
# for this project on 2026-08-27. When USE_LVR_ROUTING=true the server measures
# drive times with Google TRUCK routing (rig height/length/weight aware) FIRST,
# falling back per-leg to HERE (if enabled) and then Google car routing.
# Coverage is the contiguous US only; a leg that falls back to car routing is
# flagged to the user in the plan reply and the stop's rig-advisory pill —
# never a silent revert. Default OFF: any value other than the literal "true"
# skips the LVR branch entirely.
USE_LVR_ROUTING="false"
# Client mirror (Vite) — when "true", the map line + directions links use the
# rig-aware polyline the server attached (from LVR or HERE). Set together with
# the server USE_LVR_ROUTING flag.
VITE_USE_LVR_ROUTING="false"

# OpenWeatherMap
OPENWEATHER_API_KEY=""

# AWS S3
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
AWS_S3_BUCKET=""

# Resend (email)
RESEND_API_KEY=""
FROM_EMAIL="hello@roamready.ai"

# App
PORT=3001
CLIENT_URL="http://localhost:3000"
NODE_ENV="development"

# ============================================================
# RIDB / Recreation.gov API
# ============================================================
# Used to fetch real federal/state campground data instead of
# mock placeholders. Without this key, no campgrounds will be
# returned (intentional — better empty than fake).
#
# Get a free key:
# 1. Sign up at https://www.recreation.gov/ (creates Recreation.gov
#    account)
# 2. Visit https://ridb.recreation.gov/profile
# 3. Click "Enable Developer Access" — your APIKey will appear
# 4. Paste the key value below
RECGOV_API_KEY=
