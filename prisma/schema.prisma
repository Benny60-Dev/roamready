// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../server/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  firstName           String
  lastName            String
  passwordHash        String?
  googleId            String?
  appleId             String?
  phone               String?
  emergencyContact    String?
  emergencyPhone      String?
  homeLocation        String?
  homeAddress         String?
  homeStreet          String?
  homeCity            String?
  homeState           String?
  homeZip             String?
  homeLat             Float?
  homeLng             Float?
  avatarUrl           String?
  subscriptionTier    SubscriptionTier     @default(FREE)
  subscriptionId      String?
  customerId          String?
  trialEndsAt         DateTime?
  /// Set by the trial-ending cron endpoint when a 24h-before email is
  /// successfully sent. Idempotency guard so multiple cron firings
  /// (or a retry after partial failure) don't email the same user twice.
  trialEndEmailSentAt DateTime?
  subscriptionEndsAt  DateTime?
  /// Lifetime founder rate eligibility — set at signup based on whether
  /// the user joined before FOUNDER_CUTOFF_DATE (see config/founderPricing.ts).
  /// Drives Stripe price ID selection in createCheckout AND the price/badge
  /// display on PricingPage + PaywallModal. Once true, this never flips —
  /// founders keep their rate even if they cancel and re-subscribe later.
  founderPricing      Boolean              @default(false)
  /// Email verification state. New signups start at false; the magic-link
  /// flow (controllers/emailVerification.ts) flips this to true when the
  /// token is consumed. NOT backfilled for existing users — every account
  /// goes through verification post-deploy so we can exercise the full
  /// flow including the owner account.
  emailVerified              Boolean              @default(false)
  /// Single-use hex token (32 bytes, hex-encoded → 64 chars). Set when
  /// a verification email is sent, cleared on successful verify. @unique
  /// for O(log n) lookup at verify time and to prevent token collisions.
  /// Nullable because most users have no active token in flight.
  emailVerificationToken     String?              @unique
  /// Timestamp of the most recent verification-email send. Powers the
  /// 60-second resend rate limit. NOT a token-expiry field — links
  /// never expire per spec.
  emailVerificationSentAt    DateTime?
  isOwner             Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  rigs                Rig[]
  trips               Trip[]
  memberships         Membership[]
  notifications       NotificationSetting[]
  feedback            Feedback[]
  travelProfile       TravelProfile?
  planningSessions    PlanningSession[]
  aiUsageLogs         AIUsageLog[]
  parties             TravelParty[]
}

enum SubscriptionTier {
  FREE
  PRO
}

model Rig {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType    VehicleType
  year           Int?
  make           String?
  model          String?
  length         Float?
  height         Float?
  fuelType       String?
  mpg            Float?
  tankSize       Float?
  slideouts      String?
  electricalAmps String?
  towingSetup    String?
  isToyHauler    Boolean     @default(false)
  garageLength   Float?
  gvwr           Float?
  towVehicle     String?
  toys           Json?
  terrainTypes   Json?
  isVan          Boolean     @default(false)
  vanLength      String?
  powerSetup     Json?
  waterCapacity  Float?
  hasStarlink    Boolean     @default(false)
  isRemoteWorker Boolean     @default(false)
  isCamper       Boolean     @default(false)
  sleepSetup     String?
  isOffRoad      Boolean     @default(false)
  isDefault      Boolean     @default(false)
  currentMiles   Int?
  // ─── Plate + structured towing (commit: rig towing + plate, May 2026) ───
  // licensePlate   = the rig's own plate (motorhome OR trailer/fifth-wheel itself)
  // isTowing       = true only for motorhomes that are flat-towing a vehicle
  //                  or pulling a trailer behind them. Fifth wheels and travel
  //                  trailers ARE the thing being towed and should leave this
  //                  false. The UI gates the "Are you towing?" question.
  // towedType      = VEHICLE (toad / dinghy) or TRAILER (utility / cargo / boat).
  // towed* fields  = describe the towed unit. towedYear/Make/Model only meaningful
  //                  for VEHICLE; TRAILER usually has just length + plate.
  // The legacy free-form towVehicle / towingSetup columns above are deprecated
  // and no longer written to — kept around for rollback safety, dropped later.
  licensePlate       String?
  isTowing           Boolean      @default(false)
  towedType          TowedType?
  towedYear          Int?
  towedMake          String?
  towedModel         String?
  towedLength        Float?
  towedLicensePlate  String?
  // Second-vehicle dimensions and fuel — both added Block 7 (May 2026).
  // towedHeight: only collected in the TOW VEHICLE direction (the truck pulling
  //   the trailer/5th wheel) for future bridge-clearance / garage-fit checks.
  //   Toad sub-form omits this since a flat-towed Jeep's height never matters
  //   for the rig's own restrictions.
  // towedFuelType: also TOW VEHICLE only — diesel range/cost matters for the
  //   prime mover. The toad's fuel doesn't matter because it's unhooked at
  //   camp and just gets driven locally.
  // See client/src/utils/rigs.ts deriveSecondVehicle for the direction
  // derivation from vehicleType.
  towedHeight        Float?
  towedFuelType      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  maintenanceItems MaintenanceItem[]
}

enum VehicleType {
  RV_CLASS_A
  RV_CLASS_B
  RV_CLASS_C
  FIFTH_WHEEL
  TRAVEL_TRAILER
  TOY_HAULER
  POP_UP
  VAN
  CAR_CAMPING
}

enum TowedType {
  VEHICLE
  TRAILER
}

model TravelProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  travelStyle        String?
  maxDriveHours      Float?   @default(6)
  maxMilesPerDay     Int?
  nightlyBudget      Float?
  hookupPreference   String?
  campgroundTypes    Json?
  interests          Json?
  adults             Int      @default(1)
  children           Int      @default(0)
  hasPets            Boolean  @default(false)
  petDetails         Json?
  accessibilityNeeds Json?
  militaryStatus     String?
  firstResponder     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

enum PersonRole {
  ADULT
  TEEN
  CHILD
  INFANT
}

enum PetType {
  DOG
  CAT
  OTHER
}

model TravelParty {
  id        String   @id @default(cuid())
  userId    String?
  tripId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip      Trip?    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  isDefault Boolean  @default(false)
  notes     String?
  people    Person[]
  pets      Pet[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, isDefault])
  @@index([userId])
}

model Person {
  id                  String      @id @default(cuid())
  partyId             String
  party               TravelParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  role                PersonRole  @default(ADULT)
  name                String?
  age                 Int?
  isTraveling         Boolean     @default(true)
  isEmergencyContact  Boolean     @default(false)
  emergencyPhone      String?
  accessibilityNeeds  Json?
  dietaryNotes        String?
  militaryStatus      String?
  firstResponder      String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([partyId])
}

model Pet {
  id                   String      @id @default(cuid())
  partyId              String
  party                TravelParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  type                 PetType
  name                 String?
  breed                String?
  weightLbs            Int?
  leashTrained         Boolean     @default(true)
  comfortableInCrowds  Boolean     @default(true)
  comfortableAtNight   Boolean     @default(true)
  notes                String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([partyId])
}

model Membership {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String
  memberNumber String?
  planTier     String?
  expiresAt    DateTime?
  autoApply    Boolean   @default(true)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
}

model Trip {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  rigId          String?
  name           String
  status         TripStatus @default(PLANNING)
  startLocation  String
  endLocation    String
  startDate      DateTime?
  endDate        DateTime?
  totalMiles     Float?
  totalNights    Int?
  estimatedFuel  Float?
  estimatedCamp  Float?
  actualFuel     Float?
  actualCamp     Float?
  fuelPrice      Float?
  sharedToken    String?    @unique
  packingList    Json?
  aiConversation     Json?
  modifyConversation Json?
  itinerary          Json?
  /// Concise summary of the original PlanningSession transcript, distilled
  /// at promote time (or lazily on first Modify-with-AI open for legacy
  /// trips). Injected into the modify-mode system prompt so the assistant
  /// has continuity with what the user shared while planning. Nullable
  /// because (a) old trips precede this field, (b) summarization is
  /// best-effort and may be skipped if the AI call fails.
  planningContextSummary String? @db.Text
  // ─── Per-trip vehicle decisions (Block 8, May 2026) ─────────────────────
  // Captured by the ConfirmVehiclesModal that fires at promote time (after
  // the AI emits an <itinerary>, before the Trip row is created). Answers
  // "what are you bringing on this trip?" — distinct from the profile's
  // "what do you own?" framing.
  //
  // bringingTowed: only meaningful when deriveSecondVehicle(rig.vehicleType)
  //   === 'toad' (motorhomes — toad is optional). null = not asked (e.g.
  //   user has no rig on file and the modal was skipped, or a future API
  //   caller bypassed the modal); UI should treat null/true as "yes" (the
  //   modal's default selection). Tow-vehicle direction leaves this null
  //   since the truck is required and the modal doesn't ask.
  //
  // adHocVehicle: optional one-off vehicle the user added from the modal's
  //   "+ Add a different vehicle for this trip" link. JSON because it's a
  //   small bag of fields (year/make/model/length) and we don't expect to
  //   query into it. NOT written back to the user's profile/rigs — strictly
  //   trip-only.
  bringingTowed  Boolean?
  adHocVehicle   Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  stops          Stop[]
  planningSession PlanningSession?
  party          TravelParty?
}

enum TripStatus {
  PLANNING
  ACTIVE
  COMPLETED
  DRAFT
}

model Stop {
  id                     String        @id @default(cuid())
  tripId                 String
  trip                   Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  order                  Int
  type                   StopType      @default(DESTINATION)
  locationName           String
  locationState          String?
  latitude               Float?
  longitude              Float?
  arrivalDate            DateTime?
  departureDate          DateTime?
  nights                 Int           @default(1)
  campgroundName         String?
  campgroundId           String?
  bookingStatus          BookingStatus @default(NOT_BOOKED)
  confirmationNum        String?
  siteRate               Float?
  // Block 13 — actual cost capture. siteRate is the pre-booking estimate
  // (campground's published rate or AI guess); actualRate is the per-night
  // rate the USER recorded at booking time (after discounts / loyalty /
  // promo) and actualFees is a flat add-on for taxes + fees on top of
  // (actualRate * nights). Both nullable so unbooked stops carry neither
  // and a booked stop can record one without the other.
  actualRate             Float?
  actualFees             Float?
  estimatedFuel          Float?
  checkInTime            String?
  checkOutTime           String?
  siteNumber             String?
  notes                  String?
  hookupType             String?
  isPetFriendly          Boolean?
  isMilitaryOnly         Boolean       @default(false)
  isCompatible           Boolean       @default(true)
  incompatibilityReasons Json?
  alternates             Json?
  weatherForecast        Json?
  highwayRoute           String?
  driveDuration          String?
  driveDistanceMiles     Float?
  routeHighlights        String?
  pointsOfInterest       Json                  @default("[]")
  campgroundCandidates   Json?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  journalEntry           JournalEntry?
}

enum StopType {
  DESTINATION
  OVERNIGHT_ONLY
  HOME
}

enum BookingStatus {
  NOT_BOOKED
  PENDING
  CONFIRMED
  CANCELLED
  WAITLISTED
}

model JournalEntry {
  id         String   @id @default(cuid())
  stopId     String   @unique
  stop       Stop     @relation(fields: [stopId], references: [id], onDelete: Cascade)
  title      String?
  body       String?
  rating     Int?
  photos     Json?
  actualCost Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model MaintenanceItem {
  id               String            @id @default(cuid())
  rigId            String
  rig              Rig               @relation(fields: [rigId], references: [id], onDelete: Cascade)
  name             String
  intervalMiles    Int?
  intervalMonths   Int?
  lastServiceMiles Int?
  lastServiceDate  DateTime?
  currentMiles     Int?
  status           MaintenanceStatus @default(OK)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  logs             MaintenanceLog[]
}

model MaintenanceLog {
  id          String          @id @default(cuid())
  itemId      String
  item        MaintenanceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  serviceDate DateTime
  mileage     Int?
  notes       String?
  cost        Float?
  createdAt   DateTime        @default(now())
}

enum MaintenanceStatus {
  OK
  DUE_SOON
  OVERDUE
}

model RigDatabase {
  id      String  @id @default(cuid())
  make    String
  model   String
  class   String
  length  Float?
  height  Float?
  fuel    String?
  mpg     Float?
  tank    Float?
  slides  String?
  amps    String?
}

model Feedback {
  id          String         @id @default(cuid())
  userId      String?
  user        User?          @relation(fields: [userId], references: [id])
  type        FeedbackType
  title       String?
  body        String
  screen      String?
  rating      Int?
  importance  String?
  isPublic    Boolean        @default(true)
  status      FeedbackStatus @default(NEW)
  votes       Int            @default(0)
  voterIds    Json?
  rigType     String?
  tripContext String?
  createdAt   DateTime       @default(now())
}

enum FeedbackType {
  FEATURE_REQUEST
  BUG_REPORT
  GENERAL
  CAMPGROUND_REVIEW
}

enum FeedbackStatus {
  NEW
  PLANNED
  IN_PROGRESS
  SHIPPED
  DECLINED
}

model NotificationSetting {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    String
  enabled Boolean @default(true)
  method  Json
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())
}

model PlanningSession {
  id              String                @id @default(cuid())
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String?
  messages        Json                  @default("[]")
  partialTripData Json?
  tripId          String?               @unique
  trip            Trip?                 @relation(fields: [tripId], references: [id], onDelete: SetNull)
  status          PlanningSessionStatus @default(PLANNING)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([userId])
  @@index([userId, status])
}

enum PlanningSessionStatus {
  PLANNING
  COMPLETED
  ARCHIVED
}

model AIUsageLog {
  id                String     @id @default(cuid())
  userId            String
  sessionId         String?
  tripId            String?
  callType          AICallType
  model             String
  inputTokens       Int
  outputTokens      Int
  estimatedCostUsd  Decimal    @db.Decimal(10, 6)
  createdAt         DateTime   @default(now())

  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([callType, createdAt])
}

enum AICallType {
  CHAT
  ITINERARY
  ROUTES
  ACTIVITIES
  PACKING
  HIGHLIGHTS
  FEEDBACK
  PLACES_LOOKUP
  PLANNING_SUMMARY
}

model CampgroundCache {
  id              String   @id @default(cuid())
  queryName       String
  queryLocation   String
  cacheKey        String   @unique
  found           Boolean
  placeId         String?
  name            String?
  address         String?
  phone           String?
  website         String?
  googleMapsUrl   String?
  rating          Float?
  userRatingCount Int?
  latitude        Float?
  longitude       Float?
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@index([cacheKey])
  @@index([expiresAt])
}
