// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../server/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  firstName           String
  lastName            String
  passwordHash        String?
  googleId            String?
  appleId             String?
  phone               String?
  emergencyContact    String?
  emergencyPhone      String?
  homeLocation        String?
  homeAddress         String?
  homeStreet          String?
  homeCity            String?
  homeState           String?
  homeZip             String?
  homeLat             Float?
  homeLng             Float?
  isFullTimeRVer      Boolean  @default(false)
  dismissedHomePrompt Boolean  @default(false)
  avatarUrl           String?
  subscriptionTier    SubscriptionTier     @default(FREE)
  subscriptionId      String?
  customerId          String?
  trialEndsAt         DateTime?
  /// Set by the trial-ending cron endpoint when a 24h-before email is
  /// successfully sent. Idempotency guard so multiple cron firings
  /// (or a retry after partial failure) don't email the same user twice.
  trialEndEmailSentAt DateTime?
  subscriptionEndsAt  DateTime?
  /// Lifetime founder rate eligibility — set at signup based on whether
  /// the user joined before FOUNDER_CUTOFF_DATE (see config/founderPricing.ts).
  /// Drives Stripe price ID selection in createCheckout AND the price/badge
  /// display on PricingPage + PaywallModal. Demoted to false by the
  /// customer.subscription.deleted webhook when a founder VOLUNTARILY
  /// cancels (ToS forfeiture); involuntary churn (payment failure) keeps it.
  founderPricing      Boolean              @default(false)
  /// Set when founderPricing is demoted by a voluntary cancellation —
  /// audit trail for "why is this pre-cutoff user paying the regular rate".
  founderRateForfeitedAt DateTime?
  /// Email verification state. New signups start at false; the magic-link
  /// flow (controllers/emailVerification.ts) flips this to true when the
  /// token is consumed. NOT backfilled for existing users — every account
  /// goes through verification post-deploy so we can exercise the full
  /// flow including the owner account.
  emailVerified              Boolean              @default(false)
  /// Single-use hex token (32 bytes, hex-encoded → 64 chars). Set when
  /// a verification email is sent, cleared on successful verify. @unique
  /// for O(log n) lookup at verify time and to prevent token collisions.
  /// Nullable because most users have no active token in flight.
  emailVerificationToken     String?              @unique
  /// Timestamp of the most recent verification-email send. Powers the
  /// 60-second resend rate limit. NOT a token-expiry field — links
  /// never expire per spec.
  emailVerificationSentAt    DateTime?
  isOwner             Boolean              @default(false)
  /// Reversible account deactivation (Tier 1 account removal). Null = active.
  /// When set, the account cannot authenticate (login, OAuth, JWT refresh all
  /// reject) and is hidden from admin active lists/counts. Reversible: clearing
  /// both fields reactivates. NO personal-data scrub and NO Stripe cancellation
  /// happen here — a deactivated PRO user is still billed until cancelled
  /// separately (Tier 2). deactivatedReason is operator-supplied audit context.
  deactivatedAt       DateTime?
  deactivatedReason   String?
  /// Complimentary ("comp") Pro access granted by an owner — NO Stripe charge.
  /// Deliberately SEPARATE from subscriptionTier/subscriptionId so a comp never
  /// collides with or overwrites real Stripe state and is never touched by
  /// Stripe webhooks. compTier === PRO + (compExpiresAt null = lifetime, or now
  /// < compExpiresAt) grants Pro via hasAccess() as an ADDITIONAL path. Cleared
  /// entirely on revoke. compGrantedBy is the owner id who granted it.
  compTier            SubscriptionTier?
  compExpiresAt       DateTime?
  compReason          String?
  compGrantedBy       String?
  compGrantedAt       DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  rigs                Rig[]
  trips               Trip[]
  memberships         Membership[]
  notifications       NotificationSetting[]
  feedback            Feedback[]
  travelProfile       TravelProfile?
  planningSessions    PlanningSession[]
  aiUsageLogs         AIUsageLog[]
  parties             TravelParty[]
  journalEntries      JournalEntry[]
  visitedStates       VisitedState[]
  packingTemplates    PackingTemplate[]
}

// Saved/reusable packing lists (FR-SAVED-PACKING). A USER-level template:
// `items` mirrors Trip.packingList's shape exactly ([{ category,
// items:[{ name, required, checked, custom? }] }]) so a template can be fed
// straight through mergePackedState to seed a trip. `checked` is normalized to
// false on save (a template is a starting point, not a packed state).
model PackingTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum SubscriptionTier {
  FREE
  PRO
}

model Rig {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType    VehicleType
  year           Int?
  make           String?
  model          String?
  length         Float?
  height         Float?
  fuelType       String?
  mpg            Float?
  // Towing-adjusted MPG. Nullable so back-compat is preserved — when null
  // the fuel service falls back to the solo `mpg` above. Semantics depend
  // on rig type:
  //   · TRAILER types (FIFTH_WHEEL, TRAVEL_TRAILER, TOY_HAULER, POP_UP):
  //     this is the TOW VEHICLE's mpg with the trailer hitched — the only
  //     mileage that matters for a trailered rig, since the rig itself has
  //     no engine. `mpg` (solo) is mostly inert for trailers and exists
  //     only as the safety fallback when towing mpg isn't set.
  //   · MOTORHOME types (RV_CLASS_A/B/C, VAN): mpg while flat-towing a
  //     toad. Applies only when isTowing && (trip.bringingTowed ?? true).
  //     `mpg` remains the solo figure for trips without the toad.
  //   · CAR_CAMPING: not towing-relevant; this column is ignored.
  // Added in migration 20260525120000_add_rig_mpg_towing — towing-aware
  // fuel estimate, Pass 1 of 3 (schema + service wiring).
  mpgTowing      Float?
  tankSize       Float?
  slideouts      String?
  electricalAmps String?
  towingSetup    String?
  isToyHauler    Boolean     @default(false)
  garageLength   Float?
  gvwr           Float?
  towVehicle     String?
  toys           Json?
  terrainTypes   Json?
  isVan          Boolean     @default(false)
  vanLength      String?
  powerSetup     Json?
  waterCapacity  Float?
  hasStarlink    Boolean     @default(false)
  isRemoteWorker Boolean     @default(false)
  isCamper       Boolean     @default(false)
  sleepSetup     String?
  isOffRoad      Boolean     @default(false)
  isDefault      Boolean     @default(false)
  currentMiles   Int?
  // ─── Plate + structured towing (commit: rig towing + plate, May 2026) ───
  // licensePlate   = the rig's own plate (motorhome OR trailer/fifth-wheel itself)
  // isTowing       = true only for motorhomes that are flat-towing a vehicle
  //                  or pulling a trailer behind them. Fifth wheels and travel
  //                  trailers ARE the thing being towed and should leave this
  //                  false. The UI gates the "Are you towing?" question.
  // towedType      = VEHICLE (toad / dinghy) or TRAILER (utility / cargo / boat).
  // towed* fields  = describe the towed unit. towedYear/Make/Model only meaningful
  //                  for VEHICLE; TRAILER usually has just length + plate.
  // The legacy free-form towVehicle / towingSetup columns above are deprecated
  // and no longer written to — kept around for rollback safety, dropped later.
  licensePlate       String?
  isTowing           Boolean      @default(false)
  towedType          TowedType?
  towedYear          Int?
  towedMake          String?
  towedModel         String?
  towedLength        Float?
  towedLicensePlate  String?
  // Second-vehicle dimensions and fuel — both added Block 7 (May 2026).
  // towedHeight: only collected in the TOW VEHICLE direction (the truck pulling
  //   the trailer/5th wheel) for future bridge-clearance / garage-fit checks.
  //   Toad sub-form omits this since a flat-towed Jeep's height never matters
  //   for the rig's own restrictions.
  // towedFuelType: also TOW VEHICLE only — diesel range/cost matters for the
  //   prime mover. The toad's fuel doesn't matter because it's unhooked at
  //   camp and just gets driven locally.
  // See client/src/utils/rigs.ts deriveSecondVehicle for the direction
  // derivation from vehicleType.
  towedHeight        Float?
  towedFuelType      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  maintenanceItems MaintenanceItem[]
}

enum VehicleType {
  RV_CLASS_A
  RV_CLASS_B
  RV_CLASS_C
  FIFTH_WHEEL
  TRAVEL_TRAILER
  TOY_HAULER
  POP_UP
  VAN
  CAR_CAMPING
}

enum TowedType {
  VEHICLE
  TRAILER
}

model TravelProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  travelStyle        String?
  maxDriveHours      Float?   @default(6)
  maxMilesPerDay     Int?
  nightlyBudget      Float?
  hookupPreference   String?
  campgroundTypes    Json?
  interests          Json?
  adults             Int      @default(1)
  children           Int      @default(0)
  hasPets            Boolean  @default(false)
  petDetails         Json?
  accessibilityNeeds Json?
  militaryStatus     String?
  firstResponder     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

enum PersonRole {
  ADULT
  TEEN
  CHILD
  INFANT
}

enum PetType {
  DOG
  CAT
  OTHER
}

model TravelParty {
  id        String   @id @default(cuid())
  userId    String?
  tripId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip      Trip?    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  isDefault Boolean  @default(false)
  notes     String?
  people    Person[]
  pets      Pet[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, isDefault])
  @@index([userId])
}

model Person {
  id                  String      @id @default(cuid())
  partyId             String
  party               TravelParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  role                PersonRole  @default(ADULT)
  name                String?
  age                 Int?
  isTraveling         Boolean     @default(true)
  isEmergencyContact  Boolean     @default(false)
  isSelf              Boolean     @default(false)
  emergencyPhone      String?
  accessibilityNeeds  Json?
  dietaryNotes        String?
  militaryStatus      String?
  firstResponder      String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([partyId])
}

model Pet {
  id                   String      @id @default(cuid())
  partyId              String
  party                TravelParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  type                 PetType
  name                 String?
  breed                String?
  weightLbs            Int?
  leashTrained         Boolean     @default(true)
  comfortableInCrowds  Boolean     @default(true)
  comfortableAtNight   Boolean     @default(true)
  notes                String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([partyId])
}

model Membership {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String
  memberNumber String?
  planTier     String?
  expiresAt    DateTime?
  autoApply    Boolean   @default(true)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  // One membership per (user, type). Mirrors the @@unique([userId, isDefault])
  // pattern on TravelParty. The createMembership controller does a findFirst
  // pre-check for a friendly 409, then translates Prisma's P2002 to the same
  // 409 if a concurrent insert slips through. Verified zero duplicate
  // (userId, type) rows in the DB before adding this — additive constraint,
  // no data loss.
  @@unique([userId, type])
}

model Trip {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  rigId          String?
  name           String
  status         TripStatus @default(PLANNING)
  // Persisted trip shape (BUG-4). Nullable on purpose: existing rows are
  // "legacy/unknown" and consumers fall back to today's stop-shape inference
  // when null. No default, no backfill — the column starts empty and is wired
  // up in a later phase.
  tripType       TripType?
  startLocation  String
  endLocation    String
  startDate      DateTime?
  endDate        DateTime?
  totalMiles     Float?
  totalNights    Int?
  estimatedFuel  Float?
  estimatedCamp  Float?
  actualFuel     Float?
  actualCamp     Float?
  fuelPrice      Float?
  sharedToken    String?    @unique
  packingList    Json?
  /// Snapshot of what the packing list was generated FOR — { adults, children,
  /// pets, petTypes, nights, generatedAt }. Written by generatePackingList using
  /// the same trip.party ?? user-default resolution as the prompt; read back to
  /// power the "Made for X" subtitle and the staleness banner. Null for lists
  /// generated before this shipped (legacy → never flagged stale).
  packingListMeta Json?
  aiConversation     Json?
  modifyConversation Json?
  itinerary          Json?
  /// Concise summary of the original PlanningSession transcript, distilled
  /// at promote time (or lazily on first Modify-with-AI open for legacy
  /// trips). Injected into the modify-mode system prompt so the assistant
  /// has continuity with what the user shared while planning. Nullable
  /// because (a) old trips precede this field, (b) summarization is
  /// best-effort and may be skipped if the AI call fails.
  planningContextSummary String? @db.Text
  // ─── Per-trip vehicle decisions (Block 8, May 2026) ─────────────────────
  // Captured by the ConfirmVehiclesModal that fires at promote time (after
  // the AI emits an <itinerary>, before the Trip row is created). Answers
  // "what are you bringing on this trip?" — distinct from the profile's
  // "what do you own?" framing.
  //
  // bringingTowed: only meaningful when deriveSecondVehicle(rig.vehicleType)
  //   === 'toad' (motorhomes — toad is optional). null = not asked (e.g.
  //   user has no rig on file and the modal was skipped, or a future API
  //   caller bypassed the modal); UI should treat null/true as "yes" (the
  //   modal's default selection). Tow-vehicle direction leaves this null
  //   since the truck is required and the modal doesn't ask.
  //
  // adHocVehicle: optional one-off vehicle the user added from the modal's
  //   "+ Add a different vehicle for this trip" link. JSON because it's a
  //   small bag of fields (year/make/model/length) and we don't expect to
  //   query into it. NOT written back to the user's profile/rigs — strictly
  //   trip-only.
  bringingTowed  Boolean?
  adHocVehicle   Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  stops          Stop[]
  planningSession PlanningSession?
  party          TravelParty?
  journalEntries JournalEntry[]
}

enum TripStatus {
  PLANNING
  ACTIVE
  COMPLETED
  DRAFT
}

enum TripType {
  ROUND_TRIP
  ONE_WAY
}

model Stop {
  id                     String        @id @default(cuid())
  tripId                 String
  trip                   Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  order                  Int
  type                   StopType      @default(DESTINATION)
  locationName           String
  locationState          String?
  latitude               Float?
  longitude              Float?
  arrivalDate            DateTime?
  departureDate          DateTime?
  nights                 Int           @default(1)
  campgroundName         String?
  campgroundId           String?
  bookingStatus          BookingStatus @default(NOT_BOOKED)
  confirmationNum        String?
  siteRate               Float?
  // Block 13 — actual cost capture. siteRate is the pre-booking estimate
  // (campground's published rate or AI guess); actualRate is the per-night
  // rate the USER recorded at booking time (after discounts / loyalty /
  // promo) and actualFees is a flat add-on for taxes + fees on top of
  // (actualRate * nights). Both nullable so unbooked stops carry neither
  // and a booked stop can record one without the other.
  actualRate             Float?
  actualFees             Float?
  // Per-leg actual fuel: the real fuel cost the USER recorded for the drive
  // that ARRIVED at this stop (parallel to actualRate for lodging — the
  // arriving stop is the leg's anchor, same way driveDistanceMiles already
  // hangs here). Nullable: the first/HOME stop has none (no leg arrives
  // at it), and un-driven / un-recorded legs carry none. Replaces the
  // legacy trip-level Trip.actualFuel for totals math; that column stays
  // for now but the per-leg sum is the new source of truth.
  actualFuel             Float?
  estimatedFuel          Float?
  checkInTime            String?
  checkOutTime           String?
  siteNumber             String?
  notes                  String?
  hookupType             String?
  isPetFriendly          Boolean?
  isMilitaryOnly         Boolean       @default(false)
  isCompatible           Boolean       @default(true)
  incompatibilityReasons Json?
  alternates             Json?
  weatherForecast        Json?
  highwayRoute           String?
  driveDuration          String?
  driveDistanceMiles     Float?
  routeHighlights        String?
  pointsOfInterest       Json                  @default("[]")
  // Block 15 — one shared "things to do during your stay" list per multi-night stop.
  // Replaces the current per-day duplicated activity arrays in Trip.itinerary
  // (where a 3-night stay emits 3 near-identical lists). Nullable with no
  // default so existing rows stay null — backfill script can distinguish
  // "not yet migrated" from "intentionally empty []". Read/write code lands
  // in later Block 15 steps; this column is unused until then.
  stayActivities         Json?
  campgroundCandidates   Json?
  // RIG-CHANGE Phase 1 — accountability stamp: the rig a site was BOOKED
  // against, written at the moment bookingStatus transitions to a booked state
  // (CONFIRMED/PENDING/WAITLISTED) in updateStop. Lets a later rig swap warn
  // that prior bookings were checked against a different rig — WITHOUT ever
  // altering the reservation. All nullable: bookings made before this shipped,
  // and every NOT_BOOKED stop, carry null = "not recorded". bookedForRigType
  // references the EXISTING VehicleType enum (no enum change). towedLength is
  // captured for the record only — it is NOT used in the larger-rig fit warning.
  bookedForRigName        String?
  bookedForRigType        VehicleType?
  bookedForRigLength      Float?
  bookedForRigTowedLength Float?
  bookedForRigHeight      Float?
  bookedForRigWeight      Float?
  bookedForRigAt          DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  journalEntries         JournalEntry[]
}

enum StopType {
  DESTINATION
  OVERNIGHT_ONLY
  HOME
}

enum BookingStatus {
  NOT_BOOKED
  PENDING
  CONFIRMED
  CANCELLED
  WAITLISTED
}

model JournalEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId     String?
  trip       Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  stopId     String?
  stop       Stop?    @relation(fields: [stopId], references: [id], onDelete: SetNull)
  // Route-POI link (JOURNAL-ROUTESTOP). Itinerary "stops along the way" are
  // id-less JSON POIs in Trip.itinerary, NOT Stop rows, so they can't hang a
  // stopId. Instead the entry is keyed by the POI's stable client-generated id.
  // No FK/relation: POIs aren't a table. Nullable — only route-POI entries set
  // it. If the POI is later removed or the itinerary regenerated, the entry
  // survives (placeName keeps it readable) and demotes into the freeform list,
  // mirroring how a deleted Stop's entry demotes via onDelete:SetNull.
  routePoiId String?
  entryDate  DateTime @default(now())
  title      String?
  body       String?
  rating     Int?
  photos     Json?
  actualCost Float?
  state      String?
  lat        Float?
  lng        Float?
  placeName  String?
  tags       String[]
  // Full-text search vector over title + body + placeName (step 5). This is a
  // Postgres GENERATED ALWAYS ... STORED column — Prisma can't manage its value,
  // so it's declared Unsupported (existence only, drift-safe) and populated /
  // indexed entirely in the raw migration (20260608140000_add_journal_fts).
  search     Unsupported("tsvector")?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, entryDate])
  @@index([userId, state])
  @@index([tripId])
  @@index([stopId])
  @@index([routePoiId])
  @@index([search], type: Gin)
}

// Manual visited-state marks (Journal map, step 6b — scope Option B). The map's
// primary source is DERIVED (computed client-side from completed trips); these
// rows are the user's MANUAL overrides for drive-through states with no stop and
// for backfilling pre-RoamReady travel. Merge rule lives client-side:
// derived-overnight is authoritative and wins, so a manual row never downgrades
// earned trip data. visitType is a free String constrained to
// "overnight" | "passthrough" at the Zod layer (phase 2), matching the locked
// decision to avoid a second enum migration.
model VisitedState {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  state     String   // 2-letter code (DC allowed)
  visitType String   // "overnight" | "passthrough"
  firstSeen DateTime @default(now())
  lastSeen  DateTime @updatedAt

  @@unique([userId, state])
  @@index([userId])
}

model MaintenanceItem {
  id               String            @id @default(cuid())
  rigId            String
  rig              Rig               @relation(fields: [rigId], references: [id], onDelete: Cascade)
  name             String
  intervalMiles    Int?
  intervalMonths   Int?
  lastServiceMiles Int?
  lastServiceDate  DateTime?
  currentMiles     Int?
  status           MaintenanceStatus @default(OK)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  logs             MaintenanceLog[]
}

model MaintenanceLog {
  id          String          @id @default(cuid())
  itemId      String
  item        MaintenanceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  serviceDate DateTime
  mileage     Int?
  notes       String?
  cost        Float?
  createdAt   DateTime        @default(now())
}

enum MaintenanceStatus {
  OK
  DUE_SOON
  OVERDUE
}

model RigDatabase {
  id      String  @id @default(cuid())
  make    String
  model   String
  class   String
  length  Float?
  height  Float?
  fuel    String?
  mpg     Float?
  tank    Float?
  slides  String?
  amps    String?
}

model Feedback {
  id          String         @id @default(cuid())
  userId      String?
  user        User?          @relation(fields: [userId], references: [id])
  type        FeedbackType
  title       String?
  body        String
  screen      String?
  rating      Int?
  importance  String?
  // Private by default — only an admin's Public toggle (PATCH
  // /admin/feedback/:id) makes a row eligible for the public roadmap.
  isPublic    Boolean        @default(false)
  status      FeedbackStatus @default(NEW)
  votes       Int            @default(0)
  voterIds    Json?
  rigType     String?
  tripContext String?
  // Admin-only archive timestamp (null = active). Set/cleared via the admin
  // PATCH's `archived` boolean; never affects public roadmap visibility —
  // getPublicRoadmap filters on isPublic + status only, by design.
  archivedAt  DateTime?
  // When the submitter was emailed that their item shipped (null = never).
  // Stamped ONLY after a successful Resend send on the NEW→SHIPPED
  // transition; the stamp is the idempotency guard against re-sends.
  shippedNotifiedAt DateTime?
  createdAt   DateTime       @default(now())
}

enum FeedbackType {
  FEATURE_REQUEST
  BUG_REPORT
  GENERAL
  CAMPGROUND_REVIEW
}

enum FeedbackStatus {
  NEW
  PLANNED
  IN_PROGRESS
  SHIPPED
  DECLINED
}

model NotificationSetting {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    String
  enabled Boolean @default(true)
  method  Json
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())
}

model PlanningSession {
  id              String                @id @default(cuid())
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String?
  messages        Json                  @default("[]")
  partialTripData Json?
  tripId          String?               @unique
  trip            Trip?                 @relation(fields: [tripId], references: [id], onDelete: SetNull)
  status          PlanningSessionStatus @default(PLANNING)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([userId])
  @@index([userId, status])
}

enum PlanningSessionStatus {
  PLANNING
  COMPLETED
  ARCHIVED
}

model AIUsageLog {
  id                String     @id @default(cuid())
  userId            String
  sessionId         String?
  tripId            String?
  callType          AICallType
  model             String
  inputTokens       Int
  outputTokens      Int
  estimatedCostUsd  Decimal    @db.Decimal(10, 6)
  createdAt         DateTime   @default(now())

  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([callType, createdAt])
}

enum AICallType {
  CHAT
  ITINERARY
  ROUTES
  ACTIVITIES
  PACKING
  HIGHLIGHTS
  FEEDBACK
  PLACES_LOOKUP
  PLANNING_SUMMARY
}

model CampgroundCache {
  id              String   @id @default(cuid())
  queryName       String
  queryLocation   String
  cacheKey        String   @unique
  found           Boolean
  placeId         String?
  name            String?
  address         String?
  phone           String?
  website         String?
  googleMapsUrl   String?
  rating          Float?
  userRatingCount Int?
  latitude        Float?
  longitude       Float?
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@index([cacheKey])
  @@index([expiresAt])
}

// Result of the monthly OHV link-checker (server/src/services/ohvLinkCheck.ts,
// triggered via the /api/v1/internal/cron/ohv-link-check endpoint). One row is
// written per run; the owner-only admin view reads the most recent by
// createdAt. `dead` is the JSON array of { label, url, status }.
model OhvLinkCheck {
  id           String   @id @default(cuid())
  checkedAt    DateTime
  total        Int
  okCount      Int
  deadCount    Int
  dead         Json
  driftWarning String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// Append-only audit trail for privileged account-lifecycle actions (Tier 1
// account removal: DEACTIVATE / REACTIVATE; DELETE / ANONYMIZE reserved for
// Tier 2). targetUserId is a PLAIN STRING, intentionally NOT a relation/FK —
// the audit row must survive the target user's eventual deletion, which an
// onDelete:Cascade relation would defeat. performedBy is an owner id or
// "script:<name>" for CLI-driven actions.
model AdminActionLog {
  id           String   @id @default(cuid())
  action       String   // DEACTIVATE | REACTIVATE  (DELETE/ANONYMIZE reserved for Tier 2)
  targetUserId String   // plain string, NOT a relation/FK — must survive target deletion
  performedBy  String   // owner id, or "script:<name>"
  reason       String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([targetUserId])
}
